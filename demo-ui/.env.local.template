# demo-ui/.env.local
#
# watsonx.data Presto federation — runtime credentials for the demo UI.
# Set these on the RHEL VM BEFORE starting the UI with `npm start`.
# Never commit this file — it is listed in .gitignore.
#
# Where to get these values:
#   WXD_PRESTO_HOST    → watsonx.data console → Infrastructure → Presto engine
#                        Click the engine → "Connections" tab → copy the hostname
#                        (e.g. eu-gb.lakehouse.cloud.ibm.com).
#                        Do NOT include https:// or a trailing slash.
#   WXD_APIKEY         → TechZone reservation page → "Service API Key"
#                        (student key, not your IBM ID key)
#   WXD_INSTANCE_CRN   → TechZone reservation page → Instance CRN
#                        (starts with crn:v1:bluemix:public:lakehouse:eu-gb:...)
#
# Current reservation values (2026-09-14):
#   Instance CRN ends: e4ec7696-6363-4ad9-a21f-41eba7b7a663
#   Region: eu-gb (London)
#   Engine: prismo600 (Starter)
#
# When env vars are NOT set, the UI falls back to hardcoded stub data so the
# demo still works for storytelling without a live watsonx.data connection.

WXD_PRESTO_HOST=eu-gb.lakehouse.cloud.ibm.com
WXD_APIKEY=
WXD_INSTANCE_CRN=
