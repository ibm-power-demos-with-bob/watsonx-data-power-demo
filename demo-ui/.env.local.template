# demo-ui/.env.local
#
# watsonx.data Presto federation — runtime credentials for the demo UI.
# Set these on the RHEL VM BEFORE starting the UI with `npm start`.
# Never commit this file — it is listed in .gitignore.
#
# ============================================================
# CURRENT PATH: Developer Base Image (VMware, TechZone)
# ============================================================
#
# Reservation: IBM watsonx.data Development Lab - 2.2.0 GA
# Collection:  https://techzone.ibm.com/collection/ibm-watsonxdata-developer-base-image
#
# All values come from the reservation's "Published Services" section
# once status is Ready.
#
#   WXD_PRESTO_HOST     → the region hostname, e.g. us-east.services.cloud.techzone.ibm.com
#                         (copy from "Presto Port - Server: ..." line in reservation)
#   WXD_PRESTO_PORT     → the mapped external port for Presto (e.g. 15152)
#                         (copy from "Presto Port - Port: ..." line in reservation)
#   WXD_PRESTO_USER     → watsonx   (fixed for this image)
#   WXD_PRESTO_PASSWORD → from reservation page or diagnostic console at :8501
#                         Default credential is: watsonx.data (check :8501 to confirm)
#
# Catalog names to use (set after registering federation connectors in the
# watsonx.data UI at https://<host>:<ui-port>):
#   WXD_PG_CATALOG      → name you give the PostgreSQL connector, e.g. pg_olist
#   WXD_IBMI_CATALOG    → name you give the IBM i connector, e.g. ibmi_olist
#
# When env vars are NOT set, the UI falls back to hardcoded stub data so the
# demo still works for storytelling without a live watsonx.data connection.

# --- Developer Base Image ---
# WXD_PRESTO_HOST and WXD_PRESTO_USER/PASSWORD are FIXED for this image type.
# Only WXD_PRESTO_PORT changes per reservation — get it from the "Published Services"
# section of the TechZone reservation details page (labelled "Presto Port").
WXD_PRESTO_HOST=eu-de.services.cloud.techzone.ibm.com
WXD_PRESTO_PORT=48872
WXD_PRESTO_SCHEME=https
WXD_PRESTO_USER=ibmlhadmin
WXD_PRESTO_PASSWORD=password

# --- Catalog names (set after connector registration) ---
WXD_PG_CATALOG=pg_olist
WXD_IBMI_CATALOG=ibmi_olist

# ============================================================
# LEGACY: watsonx.data SaaS (IBM Cloud) — kept for reference
# ============================================================
# Uncomment and fill these instead if reverting to SaaS auth.
# Remove or leave blank WXD_PRESTO_USER to activate this path.
#
# WXD_PRESTO_HOST=<engine-uuid>.lakehouse.ibmappdomain.cloud
# WXD_PRESTO_PORT=31437
# WXD_PRESTO_SCHEME=https
# WXD_APIKEY=
# WXD_INSTANCE_CRN=
