# =============================================================================
# setup/config.env — local secrets for watsonx.data on IBM Power setup scripts
#
# Copy this file to setup/config.env and fill in values from your TechZone
# reservations. config.env is gitignored — never commit it.
#
# Values come from:
#   SAT_*      -> TechZone IBM Cloud Satellite reservation output
#   WXD_*      -> TechZone watsonx.data SaaS reservation output
#   COS_*      -> watsonx.data Infrastructure Manager -> Storage bucket details
#   IBMI_*     -> TechZone on-prem reservation output
# =============================================================================

# --- Satellite Connector (from TechZone IBM Cloud Satellite reservation) ---
SAT_APIKEY=
SAT_CONNECTOR_ID=
SAT_IBMI_EP_ID=
SAT_IBMI_IP=

# --- watsonx.data SaaS (from TechZone watsonx.data SaaS reservation output) ---
WXD_APIKEY=
WXD_INSTANCE_CRN=
WXD_INSTANCE_GUID=

# --- COS HMAC keys (from watsonx.data Infrastructure Manager -> Storage) ---
COS_ACCESS_KEY=
COS_SECRET_KEY=
COS_ENDPOINT=https://s3.direct.eu-gb.cloud-object-storage.appdomain.cloud
COS_BUCKET=
COS_REGION=eu-gb
ICEBERG_BASE=iceberg_data2/retail
